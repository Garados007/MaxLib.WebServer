[*.cs]

# CS1570: XML-Kommentar weist ein ungültiges Format auf
dotnet_diagnostic.CS1570.severity = silent

# CS1591: Fehledes XML-Kommentar für öffentlich sichtbaren Typ oder Element
dotnet_diagnostic.CS1591.severity = silent

[MaxLib.WebServer/**.cs]

# CA1805: Do not initialize unnecessarily
dotnet_diagnostic.CA1805.severity = error

# CA1507: Use nameof to express symbol names
dotnet_diagnostic.CA1507.severity = error

# CA1510: Use ArgumentNullException throw helper
dotnet_diagnostic.CA1510.severity = error

# CA1512: Use ArgumentOutOfRangeException throw helper
dotnet_diagnostic.CA1512.severity = error

# CA1513: Use ObjectDisposedException throw helper
dotnet_diagnostic.CA1513.severity = error

# CA2208: Instantiate argument exceptions correctly
dotnet_diagnostic.CA2208.severity = error

# CA1816: Dispose methods should call SuppressFinalize
dotnet_diagnostic.CA1816.severity = error

# CA2000: Dispose objects before losing scope
dotnet_diagnostic.CA2000.severity = error

# CA1062: Validate arguments of public methods
dotnet_diagnostic.CA1062.severity = error

# CA1307: Specify StringComparison for clarity
dotnet_diagnostic.CA1307.severity = error

# CA1310: Specify StringComparison for correctness
dotnet_diagnostic.CA1310.severity = error

# CA1309: Use ordinal string comparison
dotnet_diagnostic.CA1309.severity = error

# CA1866: Use the 'StringComparison.Ordinal' char overload
dotnet_diagnostic.CA1866.severity = error

# CA1834: Use StringBuilder.Append(char) for single-character string literals
dotnet_diagnostic.CA1834.severity = error

# CA1820: Test for empty strings using string length instead of Equals("")
dotnet_diagnostic.CA1820.severity = error

# CA1304: Specify CultureInfo
dotnet_diagnostic.CA1304.severity = error

# CA1862: Use the 'StringComparison' method overloads for case-insensitive comparisons
dotnet_diagnostic.CA1862.severity = error

# CA1311: Specify a culture or use an invariant version to avoid implicit dependency on current culture
dotnet_diagnostic.CA1311.severity = error

# CA1305: Specify IFormatProvider
dotnet_diagnostic.CA1305.severity = error
